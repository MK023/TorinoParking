# Development: self-signed TLS on localhost
# Production: replace "localhost" with your domain for automatic Let's Encrypt
{
	admin off
}

# Routing condiviso: API/docs -> backend, resto -> frontend
(app) {
	handle /api/* {
		reverse_proxy backend:8000
	}
	handle /health {
		reverse_proxy backend:8000
	}
	handle /docs {
		reverse_proxy backend:8000
	}
	handle /redoc {
		reverse_proxy backend:8000
	}
	handle /openapi.json {
		reverse_proxy backend:8000
	}
	# Frontend (catch-all)
	handle {
		reverse_proxy frontend:3000
	}
}

localhost {
	import app
}

# Tunnel ngrok per test su iPhone: HTTP puro (ngrok termina lui l'HTTPS pubblico).
# NGROK_DOMAIN arriva dal .env via docker-compose; default innocuo se assente.
http://{$NGROK_DOMAIN:tunnel.disabled} {
	import app
}
